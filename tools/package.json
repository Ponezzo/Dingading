{
  "name": "ding-ga-ding-tools",
  "private": true,
  "scripts": {
    "merge-openapi": "openapi-merge-cli --config ../docs/openapi-merge.json",
    "codegen:spring": "openapi-generator-cli generate -i ../docs/output/openapi.yaml -g spring -o ../backend/generated -t ../generator/spring-custom-generator/custom-codegen -c ../generator/spring-custom-generator/config.json",
    "codegen:axios": "openapi-generator-cli generate -i ../docs/output/openapi.yaml -g typescript-axios -o ../frontend/generated -t ../generator/axios-custom-generator/custom-codegen -c ../generator/axios-custom-generator/config.json",
    "codegen": "npm run merge-openapi && npm run codegen:spring && npm run codegen:axios"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "openapi-merge-cli": "^1.3.0"
  }
}
