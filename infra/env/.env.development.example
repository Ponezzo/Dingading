# 로컬 개발 환경 변수 (Docker 없이 사용)
# 사용법: 이 파일을 .env.development 로 복사한 뒤 값을 수정하세요.
#   copy infra\env\.env.development.example infra\env\.env.development

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=1234
MYSQL_DATABASE=ding_ga_ding

# --- MongoDB ---
MONGO_DB_HOST=localhost
MONGO_DB_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=1234
MONGO_INITDB_DATABASE=ding_ga_ding

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ROOT_PASSWORD=1234

# --- RabbitMQ ---
RABBIT_MQ_HOST=localhost
RABBIT_MQ_PORT=5672
RABBITMQ_DEFAULT_USER=root
RABBITMQ_DEFAULT_PASS=1234

# --- MinIO ---
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_USERNAME=root
MINIO_PASSWORD=12341234
MINIO_BUCKET=original-mp3-audio-bucket

# --- Spring Boot ---
SPRING_ENV_MODE=DEVELOPMENT_LOCAL
SPRING_AI_SERVICE_URL=http://localhost:8000
JPA_DDL_AUTO=create
JPA_SHOW_SQL=true
SQL_INIT_MODE=always
LOGGING_LEVEL=debug

# JWT (로컬 개발용 더미 값)
JWT_SECRET_KEY=local-dev-jwt-secret-key-change-me-32chars-min
JWT_ACCESS_TOKEN_EXPIRE_TIME=100000

# Google OAuth (실제 값 없으면 로그인 불가)
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:8080/login
FRONT_REDIRECT_URI=http://localhost:3000/main

# OpenVidu (실제 값 없으면 라이브하우스 일부 기능 불가)
OPENVIDU_HOST=localhost
OPENVIDU_PORT=4443
OPENVIDU_SECRET=local-openvidu-secret

# --- AI / Celery ---
ENV_MODE=development
CELERY_BROKER_URL=redis://:1234@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:1234@localhost:6379/0
